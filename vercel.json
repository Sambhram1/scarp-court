{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/debug",
            "destination": "/api/debug"
        },
        {
            "source": "/api/cause-list",
            "destination": "/api/cause-list"
        },
        {
            "source": "/(.*)",
            "destination": "/public/$1"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}